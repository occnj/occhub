# Copy to /home/occnj/occ_hub/.backup.env on the Pi  (chmod 600). Lines starting with # are ignored.

# Where to send backups: <backup user>@<droplet address>:   (note the trailing colon)
BACKUP_REMOTE=occbackup@hub.example.com:

# The private key you generated for this (see docs/BACKUP_AND_MIGRATION.md, step 2)
BACKUP_SSH_KEY=/home/occnj/.ssh/occhub_backup
# BACKUP_SSH_PORT=22

# The database holds prayer requests and contact details, so it is encrypted before it leaves
# the Pi. Put a long random passphrase in this file (chmod 600) and keep a copy somewhere
# safe that is NOT the droplet: without it the backups cannot be opened.
BACKUP_PASSPHRASE_FILE=/home/occnj/.occhub-backup-passphrase

# --- optional -------------------------------------------------------------------------------
# Snapshots kept on the Pi itself (default 7)
# KEEP_LOCAL=7
# Be gentle on the church internet connection (KB/s, 0 = unlimited)
# BACKUP_BWLIMIT_KBPS=2000
# Also delete from the droplet the uploads you deleted on the Pi. Off by default so a mistake
# on the Pi cannot erase the backup.
# BACKUP_SYNC_DELETE=1
# Alerts: create a free check at healthchecks.io (or similar), paste its ping URL here, and
# you get an email if the nightly backup fails OR stops running altogether.
# BACKUP_PING_URL=https://hc-ping.com/your-uuid-here
